<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/shared_courses/db" VERSION="2026021801" COMMENT="Shared courses table">
    <TABLES>
        <TABLE NAME="shared_courses" COMMENT="Stores shared courses added by manager">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>

                <FIELD NAME="course_id" TYPE="int" LENGTH="10" NOTNULL="true"/>
                
                <FIELD NAME="status" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
                
                <FIELD NAME="user_id" TYPE="int" LENGTH="10" NOTNULL="true"/>
                
                <FIELD NAME="created_at" TYPE="varchar" LENGTH="255" NOTNULL="true"/>
                
                <FIELD NAME="updated_at" TYPE="varchar" LENGTH="255" NOTNULL="true"/>
            </FIELDS>

            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="coursefk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
                <KEY NAME="userfk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>

            <INDEXES>
                <INDEX NAME="course_idx" UNIQUE="false" FIELDS="courseid"/>
                <INDEX NAME="user_idx" UNIQUE="false" FIELDS="userid"/>
            </INDEXES>

        </TABLE>
    </TABLES>
</XMLDB>
