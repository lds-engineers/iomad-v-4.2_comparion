function local_customlayout_after_require_login()
{
    global $PAGE;
    // print_r($PAGE->pagetype);
    // die;
    if ((substr($PAGE->pagetype, 0, strlen('admin-')) != 'admin-') && (substr($PAGE->pagetype, 0, strlen('course-')) != 'course-') && (substr($PAGE->pagetype, 0, strlen('mod-')) != 'mod-')) {
        $PAGE->requires->jquery();
        $PAGE->requires->js('/local/customlayout/js/custom_layout.js');
    }
}
function local_customlayout_before_http_headers() {
    global $PAGE;
    $PAGE->requires->jquery();
}

function local_customlayout_before_standard_top_of_body_html()
{
    global $PAGE,$CFG, $DB;
    // $PAGE->requires->jquery();

    $current_host = isset($_SERVER['HTTP_HOST']) ? strtolower($_SERVER['HTTP_HOST']) : '';
    $request_uri  = isset($_SERVER['REQUEST_URI']) ? $_SERVER['REQUEST_URI'] : '/';

    $scheme = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') || (isset($_SERVER['SERVER_PORT']) && $_SERVER['SERVER_PORT'] == 443) ? 'https' : 'http';
    $fullurl = $scheme . '://' . $current_host . $request_uri;

    $company = $DB->get_record_sql(
        "SELECT id FROM {company} WHERE hostname = :host",
        ['host' => $current_host]
    );
    if($company){
        $settag = get_config(null, "googletagmanager{$company->id}");
        if(!empty($settag)){
            $html .= '
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id='.$settag.'"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
                    ';
        }
    }

    $html = '';
    $html .= '<link rel="stylesheet" type="text/css" href="' . $CFG->wwwroot . '/local/customlayout/style.css" />';
    $html .= '<style>';
    if (is_siteadmin()) {
        $html .= '
            .activity-navigation.mdl-bottom .urlselect {
                display:none;
            }
        ';
    }

    if(!is_siteadmin()){
        $html .=  '
            .secondary-navigation .moremenu{
                display:none;
            }
        ';
    }
    $html .= '


        nav.navbar[aria-label="Site navigation"]>button.aabtn {
            display: none !important;
        }

        .iomadlink_container>a{
           margin: 0px !important;
        }

         img.mgu_img {
          filter: contrast(0.5);
          transform: scale(0.9);
        }
        img.mbu_img {
          transform: scale(0.8);
          filter: contrast(0.3);
        }
        img.brc_img {
          transform: scale(0.8);
          filter: contrast(0.5);
        }
        img.logout_img{
          transform: scale(0.8);
          filter: contrast(0.5);
        }
        img.coupon_img {
            transform: scale(0.8);
            filter: contrast(0.2);
        }   

        #page-login-index #loginlogo{
            display: none;
        }
        .navbar-brand .logo {
          display: none;
        }
        #page-user-preferences .container-fluid {
            margin-left : 0px !important;
        }
        #page-user-preferences .card-title {
            display : none !important;
        }
        #page-local-customlayout-company-logo div#fitem_id_logo_image {
            display: block !important;
        }
        #page-my-index .block_iomad_commerce {
            margin: 28px !important;
        }
        #page-user-preferences #page-header{
            display:none;
        }
        #page-user-preferences a[href^="' . $CFG->wwwroot . '/user/calendar.php"],a[href^="' . $CFG->wwwroot . '/user/contentbank.php"],a[href^="' . $CFG->wwwroot . '/message/edit.php"]{
            display: none;

        }
        #page-user-profile a[href^="' . $CFG->wwwroot . '/mod/customcert/my_certificates.php"],a[href^="' . $CFG->wwwroot . '/blog/index.php"],a[href^="' . $CFG->wwwroot . '/mod/forum/user.php"],a[href^="' . $CFG->wwwroot . '/admin/tool/lp/plans.php"],a[href^="' . $CFG->wwwroot . '/report/usersessions/user.php"],a[href^="' . $CFG->wwwroot . '/grade/report/overview/index.php"]{
          display: none !important;
        }
        #page-user-preferences a[href^="' . $CFG->wwwroot . '/user/contentbank.php"]{
        display:none;
        }

        .cst-sidebar a.nav-link {
            display: flex;
            align-items: center;
        }
        
        
        ';
    $html .= '</style>';
    return $html;
}


function local_customlayout_before_footer()
{
    global $PAGE, $DB, $CFG, $USER;
    if (empty($USER->id) || $USER->id <= 1) {
        return;
    }
    if ((substr($PAGE->pagetype, 0, strlen('admin-')) != 'admin-') && (substr($PAGE->pagetype, 0, strlen('course-')) != 'course-') && (substr($PAGE->pagetype, 0, strlen('mod-')) != 'mod-')) {
    } else {
        return;
    }
    $returnbacklink = '';
    if (isloggedin() && !isguestuser()) {
        if(!empty($USER->realuser) && $USER->realuser != $USER->id){
            if($originaluser = $DB->get_record("user", array("id"=>$USER->realuser, "confirmed"=>1, "deleted"=>0))){
                $returnbacklink = '
                <li>
                    <a href="' . $CFG->wwwroot . '/login/returnback.php" class="nav-link text-dark">
                       <img class="mx-2 logout_img" src="' . $CFG->wwwroot . '/local/customlayout/pix/returnback.png" style="width:30px; height:30px""/>
                         Return Back to '.fullname($originaluser).'
                     </a>
                </li>
                ';
            }
        }
    }

    require_once($CFG->dirroot . "/course/externallib.php");
    $userpicture = new user_picture($USER);
    $userpicture->size = 1; // Size f1.
    $img = $userpicture->get_url($PAGE)->out(false);


    $context = context_user::instance($USER->id); // User context
    $current_user_roles = get_user_roles($context, $USER->id);
    $manag_role = array_column($current_user_roles, 'shortname');
    // $companyid = iomad::get_my_companyid(context_system::instance());
