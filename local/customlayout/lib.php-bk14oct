    <script>
    
          document.addEventListener("DOMContentLoaded", function () {
            // Toggle slider using trigger
            const trigger = document.querySelector(".trigger");
            const closebutton = document.querySelector(".cst-close");

            if (trigger) {
              trigger.addEventListener("click", function () {
                document.body.classList.add("adjust");
              });
            }

            if (closebutton) {
              closebutton.addEventListener("click", function () {
                document.body.classList.remove("adjust");
              });
            }

            // Use event delegation for nav list clicks
            const navList = document.querySelector(".my-nav-list");
            if (navList) {
              navList.addEventListener("click", function (e) {
                const clickedItem = e.target.closest("li");
                if (!clickedItem) return;

                // Remove active from all
                navList.querySelectorAll("li").forEach(li => li.classList.remove("active"));

                // Add to clicked
                clickedItem.classList.add("active");
              });
            }
          });

    </script>



