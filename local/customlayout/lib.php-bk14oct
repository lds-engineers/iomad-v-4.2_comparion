        .trigger {
        /* Size */
        width: 90px;
        -webkit-width: 90px;
        -moz-width: 90px;
        -ms-width: 90px;
        -o-width: 90px;

        /* Background */
        background: #0f47ad;
        -webkit-background: #0f47ad;
        -moz-background: #0f47ad;
        -ms-background: #0f47ad;
        -o-background: #0f47ad;

        /* Text alignment and font */
        text-align: center;
        -webkit-text-align: center;
        -moz-text-align: center;
        -ms-text-align: center;
        -o-text-align: center;

        font-size: 30px;
        -webkit-font-size: 30px;
        -moz-font-size: 30px;
