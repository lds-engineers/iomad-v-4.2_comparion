        -webkit-color: #fff;
        -moz-color: #fff;
        -ms-color: #fff;
        -o-color: #fff;

        /* Border radius */
        border-radius: 20px;
        -webkit-border-radius: 20px;
        -moz-border-radius: 20px;
        -ms-border-radius: 20px;
        -o-border-radius: 20px;

        /* Positioning */
        position: absolute;
        -webkit-position: absolute;
        -moz-position: absolute;
        -ms-position: absolute;
        -o-position: absolute;

        top: 71px;
        -webkit-top: 71px;
        -moz-top: 71px;
        -ms-top: 71px;
        -o-top: 71px;

        left: -16px;
        -webkit-left: -16px;
        -moz-left: -16px;
        -ms-left: -16px;
        -o-left: -16px;

        /* Display */
        display: none;
        -webkit-display: none;
        -moz-display: none;
        -ms-display: none;
        -o-display: none;

        /* Layer order */
        z-index: 999;
        -webkit-z-index: 999;
        -moz-z-index: 999;
        -ms-z-index: 999;
        -o-z-index: 999;

        /* Font rendering */
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        -webkit-text-stroke: 0px transparent;
        }


        .cst-close {
            font-size: 20px;
            font-weight: bolder;
            color: #fff;
            position: absolute;
            right: 0px;
            display:none;
            background-color: black;
            top: -1px;
            width: 50px;
            text-align: center;
            cursor: pointer;
        }

        .drawer.show + div#page {
            width: calc(100% - 575px) !important;
            margin-left: 250px !important;
        }

        div#page {
            width: calc(100% - 152px);
            margin-left: 146px;
        }

        .secondary-navigation {
            width: calc(100% - 250px) !important;
            margin-left: 250px;
        }

        ::-webkit-scrollbar {
          width: 5px;
        }

        footer#cst-footer {
            padding: 0px 10px; 
            position: fixed;
            background-color: #343a40;
            left: 0;
            right: 0;
            bottom:0;
            width: 100%;
            color: #fff;
        }

        footer#cst-footer .menu_parent ul {
            padding: 0;
            margin: 0;
            list-style: none;
            display: flex;
            justify-content: center;
        }

        footer#cst-footer .menu_parent ul li {
            padding: 20px;
            position:relative;
        }

        footer#cst-footer .menu_parent ul li:after {
            content: "";
            position: absolute;
            width: 1px;
            background-color: #d9d9d9;
            height: 43%;
            margin-left: 13px;
        }

        footer#cst-footer .menu_parent ul li a {
            color: #d9d9d9;
            font-size: 16px;
            text-decoration: none;
        }

        footer#cst-footer .details_parent {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            margin: 0;
            color: #d9d9d9;
        }

        footer#cst-footer .details_parent p span {
            color: #767676;
        }

        @media(max-width:991px){
            div#page{
                 margin-left: 185px;
            }
            .custom-cart {
            top: 80px;
            }
        }


        @media(max-width:767px){
            .cst-close{
             display:block
            }


            #page-wrapper #page {
             margin: 100px 0 0 0 !important;
            }

            .cst-sidebar {
                transform: translateX(-100%);
                transition: all .5s ease-in-out;
            }

            .trigger{
            display:block;
             -webkit-display:block;
            -moz-display:block;
            -ms-display:block;
            -o-display:block;
            }


            div#page {
                width: 100%;
                margin-left: 0;
            }
                
